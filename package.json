{
  "name": "lonelog-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css":  "npx @tailwindcss/cli -i src/css/main.tw.css -o _site/css/main.css --minify",
    "build:11ty": "eleventy",
    "build":      "npm run build:11ty && npm run build:css",
    "start:css":  "npx @tailwindcss/cli -i src/css/main.tw.css -o _site/css/main.css --watch",
    "start:11ty": "eleventy --serve",
    "start":      "npm run build:css && npm-run-all --parallel start:*",
    "deploy":     "npm run build && node scripts/deploy.js",
    "debug":      "DEBUG=Eleventy* eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy":          "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "@tailwindcss/cli":        "^4.0.0",
    "@tailwindcss/typography": "^0.5.0",
    "dotenv":                  "^16.0.0",
    "npm-run-all2":            "^6.0.0",
    "ssh2-sftp-client":        "^10.0.0",
    "tailwindcss":             "^4.0.0"
  }
}
