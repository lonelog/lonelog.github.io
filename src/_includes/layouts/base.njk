<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }} Blog">
</head>
<body class="bg-page text-ink antialiased">

<!-- NAV -->
<nav class="sticky top-0 z-50 h-14 bg-page border-b border-wire">
    <div class="max-w-site mx-auto px-6 h-full flex items-center justify-between">
        <a href="/" class="font-display font-bold text-base tracking-tight">{{ site.title }}</a>
        <div class="flex items-center gap-5">
            <a href="/blog/"
               class="nav-link nav-blog"
               {% if "/blog" in page.url %}aria-current="page"{% endif %}>Blog</a>
            <a href="{{ site.docs }}"
               class="nav-link nav-docs">Docs</a>
            <a href="{{ site.github }}" class="nav-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                GitHub
            </a>
        </div>
    </div>
</nav>

{{ content | safe }}

<!-- FOOTER -->
<footer class="border-t border-wire py-8">
    <div class="max-w-site mx-auto px-6 flex flex-wrap items-center justify-between gap-1.5">
        <p class="font-serif text-sm text-muted">
            Specification released under
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline underline-offset-2 hover:text-ink">CC BY-SA 4.0</a>.
            Created by <a href="{{ site.authorUrl }}" class="underline underline-offset-2 hover:text-ink">{{ site.author }}</a>.
        </p>
        <p class="font-serif text-sm text-muted">
            <a href="{{ site.github }}" class="underline underline-offset-2 hover:text-ink">lonelog/lonelog</a>
        </p>
    </div>
</footer>

</body>
</html>
