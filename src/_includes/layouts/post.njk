---
layout: layouts/base.njk
---
<main>
    <div class="max-w-site mx-auto px-6">
        <a href="/blog/" class="back-link">&#8592; All posts</a>

        <header class="pt-14 pb-10">
            <div class="flex items-center gap-3 mb-4">
                <time class="font-mono text-xs text-muted" datetime="{{ date | dateISO }}">
                    {{ date | dateDisplay }}
                </time>
                {% if category %}
                <span class="badge badge-{{ category }}">{{ category | categoryLabel }}</span>
                {% endif %}
            </div>
            <h1 class="font-display font-black text-ink leading-[1.1] tracking-tighter mb-4"
                style="font-size: clamp(1.75rem, 5vw, 2.75rem)">{{ title }}</h1>
            {% if description %}
            <p class="text-[1.0625rem] text-muted max-w-xl leading-[1.75]">{{ description }}</p>
            {% endif %}
        </header>

        <hr class="border-t border-wire mb-10">

        <article class="prose-lonelog prose max-w-none mb-0">
            {{ content | safe }}
        </article>

        <div class="border-t border-wire mt-12 pt-10 pb-8">
            <a href="/blog/" class="back-link mb-0">&#8592; All posts</a>
        </div>
    </div>
</main>
